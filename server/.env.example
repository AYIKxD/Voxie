# Voxie server configuration
# Copy to `.env` and fill in your keys. `.env` is gitignored.

# --- LLM provider ---
# One of: openai | anthropic | (anything else = built-in mock reply)
LLM_PROVIDER=openai

# Only the key for the selected provider is required.
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GEMINI_API_KEY=your-gemini-key

# --- ASR (faster-whisper) ---
# tiny | base | small | medium | large-v3
WHISPER_MODEL=base

# --- TTS (Piper) ---
# Path to a Piper .onnx voice (or a voice name resolvable by your piper build)
PIPER_VOICE=en_US-lessac-medium
